---
import Layout from '../layouts/Layout.astro';
import "../styles/global.css";
---

<Layout title="Home">
<!-- Hero -->
  	<section class="text-center py-20 bg-gray-50 rounded-xl">
    	<h1 class="text-5xl font-extrabold text-gray-900">Cool New Product</h1>
    	<p class="mt-6 text-lg text-gray-600 max-w-2xl mx-auto">
      		Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed viverra purus vel
      		magna semper fermentum. Curabitur vel libero vitae risus vulputate gravida.
    	</p>
    <a href="/contact" class="mt-8 inline-block px-8 py-4 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition">
      Get in Touch
    </a>
  	</section>
  <!-- Features -->
	<section class="grid md:grid-cols-3 gap-8 mt-20">
		<div class="p-6 bg-white rounded-lg shadow hover:shadow-lg transition">
			<img src="/public/fast.jpg" alt="Fast" class="rounded mb-4 w-full h-48 object-cover" />
			<h3 class="text-xl font-bold mb-2">Fast</h3>
			<p>Lorem ipsum dolor sit amet, consectetur adipiscing elit.</p>
		</div>
		<div class="p-6 bg-white rounded-lg shadow hover:shadow-lg transition">
			<img src="/public/modern.jpg" alt="Modern" class="rounded mb-4 w-full h-48 object-cover" />
			<h3 class="text-xl font-bold mb-2">Modern</h3>
			<p>Donec facilisis lacus nec sapien volutpat condimentum.</p>
		</div>
		<div class="p-6 bg-white rounded-lg shadow hover:shadow-lg transition">
			<img src="/public/easy.jpg" alt="Easy" class="rounded mb-4 w-full h-48 object-cover" />
			<h3 class="text-xl font-bold mb-2">Easy</h3>
			<p>Praesent porttitor ligula nec mauris feugiat, sit amet dapibus erat fermentum.</p>
		</div>
	</section>